# Salin menjadi .env lalu sesuaikan. Vite hanya mengekspos variabel
# berawalan VITE_; nilainya terkompilasi ke bundel — jangan isi rahasia.
# Backend aktif: "laravel" atau "fiber" (Tugas 3 Modul 9)
VITE_API_AKTIF=fiber
VITE_API_LARAVEL=http://127.0.0.1:8000/api
VITE_API_FIBER=http://localhost:3000/api
