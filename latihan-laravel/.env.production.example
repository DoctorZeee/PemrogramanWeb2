APP_NAME="Pemweb2 Laravel API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.contoh.ac.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pemweb2_laravel
DB_USERNAME=pemweb2
DB_PASSWORD=GANTI_DENGAN_PASSWORD_KUAT

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Sesuaikan origin frontend produksi; jangan gunakan wildcard di produksi.
# SANCTUM_STATEFUL_DOMAINS=app.contoh.ac.id

CORS_ALLOWED_ORIGINS=https://app.contoh.ac.id
